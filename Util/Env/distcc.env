#!/bin/sh

# Determine the directory of the sourced script
CURRENT_DIR=$(pwd)
ENV_DIR="${CURRENT_DIR}/Util/Env"
BREW_ENV_FILE="${ENV_DIR}/homebrew-llvm.env"
if ! command -v uname >/dev/null 2>&1; then
    echo "udev is required. Set up a POSIX userspace and try again"
    return 1
fi

OS="$(uname)"
ARCH="$(uname -m)"
FULL_ARCH="$(uname -a)"

portable_nproc() {
    if [ "$OS" = "Linux" ]; then
        NPROCS="$(nproc --all)"
    elif [ "$OS" = "Darwin" ] || \
         [ "$(echo "$OS" | grep -q BSD)" = "BSD" ]; then
        NPROCS="$(sysctl -n hw.ncpu)"
    else
        NPROCS="$(getconf _NPROCESSORS_ONLN)"  # glibc/coreutils fallback
    fi
    echo "$NPROCS"
}

# Check if 'Util/Env' is accessible from the current directory
if [[ ! -d "${CURRENT_DIR}/Util/Env" ]]; then
    echo "Error: 'Util/Env' directory is not accessible from the current directory."
    echo "Skipping environment setup."
    echo $CURRENT_DIR
    return 1
fi

# Source the homebrew-llvm.env script
# Adjust the path if homebrew-llvm.env is located elsewhere
if [[ -z "${HOMEBREW_LLVM}" ]] && [[ "$(uname)" == "Darwin" ]] && [[ -f "${BREW_ENV_FILE}" ]]; then
    . "${ENV_DIR}/homebrew-llvm.env"
else
    if [[ "$(uname)" == "Darwin" ]] && [[ -z "${HOMEBREW_LLVM}" ]]; then
        echo "Warning: '$(basename ${BREW_ENV_FILE})' not found in ${ENV_DIR}."
        echo "Skipping environment setup."
    fi
fi

# Ensure 'distcc' is installed
if ! command -v distcc >/dev/null 2>&1; then
    echo "Error: 'distcc' is not installed. Please install it."
    return 1
fi

# Capture the system's architecture using uname -m
CPUARCH=$(uname -m)

if [[ "$OS" == "Darwin" ]]; then
    export CFLAGS="-arch $CPUARCH"
    export CXXFLAGS="-arch $CPUARCH"
fi

if command -v clang >/dev/null 2>&1; then
    TARGET_TRIPLET=$(clang -dumpmachine)
    export CMAKE_CXX_COMPILER_TARGET="$TARGET_TRIPLET"
    export CMAKE_CC_COMPILER_TARGET="$TARGET_TRIPLET"
else
    echo "Warning: 'clang' is not available. Cannot determine target triplet."
fi

# Set CMake to use 'distcc' as the compiler launcher
export CMAKE_C_COMPILER_LAUNCHER="distcc"
export CMAKE_CXX_COMPILER_LAUNCHER="distcc"

# Optionally, set the number of jobs 'distcc' can run in parallel
export DISTCC_FALLBACK=1
export DISTCC_BACKOFF_PERIOD=0
export DISTCC_JOBS=$(portable_nproc)

echo "Distcc Environment setup complete."
echo "WARNING: Be sure to reconfigure the project WITHOUT ccache or you may incur strange errors"

# vim: set ts=4 sts=4 expandtab sw=4 :
